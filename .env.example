# ─────────────────────────────────────────────────────────────
#  Tekvosoft — configuração única
#
#  Copie para .env e ajuste. Este é o ÚNICO arquivo que você edita.
#  Todo o resto (URLs, string de conexão, portas internas) é derivado
#  automaticamente nos docker-compose.
#
#      cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Obrigatório ──────────────────────────────────────────────

# Domínio onde o sistema vai responder.
# Em produção: precisa ter DNS apontando para este servidor.
# Em desenvolvimento: deixe localhost.
DOMAIN=localhost

# E-mail do administrador. Vira o login do primeiro acesso
# (senha inicial: 123456 — troque assim que entrar) e é usado
# para registrar o certificado HTTPS.
ADMIN_EMAIL=admin@tekvosoft.local

# Senha do banco de dados. Gere uma longa e aleatória:
#     openssl rand -base64 32
DB_PASS=troque-esta-senha-antes-de-subir

# ── Produção ─────────────────────────────────────────────────

# De onde vêm as imagens compiladas pelo GitHub Actions.
REGISTRY=ghcr.io/tekvosoft-chat

# Versão a rodar. "latest" acompanha a última release.
# Para travar numa versão específica, use uma tag: TAG=v1.4.2
TAG=latest

# ── Opcionais ────────────────────────────────────────────────

TZ=America/Sao_Paulo

# reCAPTCHA no cadastro de empresas (deixe vazio para desligar)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Integração com Facebook/Instagram (deixe vazio para desligar)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Token de verificação dos webhooks da Meta
VERIFY_TOKEN=tekvosoft

# Limites da instância
USER_LIMIT=10000
CONNECTIONS_LIMIT=100000

# Dias de teste grátis para empresas que se cadastram sozinhas
TRIAL_DAYS=14

# ── Só afetam o ambiente de desenvolvimento ──────────────────

# Portas no host. Se alguma já estiver ocupada na sua máquina, o
# ./tekvosoft dev detecta e troca pela próxima livre automaticamente.

# frontend
PORT=3000
# backend
API_PORT=8080

DB_PORT_HOST=5432
REDIS_PORT_HOST=6379
DEBUG_PORT=9229
