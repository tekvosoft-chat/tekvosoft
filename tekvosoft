#!/usr/bin/env bash
#
#  vuup.me — um comando para tudo.
#
#      ./tekvosoft dev       desenvolver na sua máquina (hot reload)
#      ./tekvosoft deploy    subir em produção com HTTPS
#      ./tekvosoft update    atualizar a produção
#
#  ./tekvosoft help mostra o resto.

set -euo pipefail

# Resolve symlinks: o instalador cria /usr/local/bin/tekvosoft apontando
# para cá, e precisamos acabar na pasta do projeto, não na do link.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK=$(readlink "$SELF")
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
cd "$(dirname "$SELF")"

BASE=docker-compose.yml
DEV="-f $BASE -f docker-compose.dev.yml"
PROD="-f $BASE -f docker-compose.prod.yml"

# ── aparência ────────────────────────────────────────────────
if [ -t 1 ]; then
  B=$'\e[1m'; DIM=$'\e[2m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; N=$'\e[0m'
else
  B=""; DIM=""; R=""; G=""; Y=""; C=""; N=""
fi
say()  { echo "${C}→${N} $*"; }
ok()   { echo "${G}✓${N} $*"; }
warn() { echo "${Y}!${N} $*"; }
die()  { echo "${R}✗${N} $*" >&2; exit 1; }

# ── verificações ─────────────────────────────────────────────
need_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker não está instalado.
    Instale com:  curl -sSL https://get.docker.com | sudo sh"
  docker compose version >/dev/null 2>&1 || die "Você tem Docker, mas sem o plugin Compose v2.
    Atualize o Docker: https://docs.docker.com/engine/install/"
  docker info >/dev/null 2>&1 || die "O Docker está instalado mas não responde.
    Tente:  sudo systemctl start docker
    Se precisar de sudo para usar docker:  sudo usermod -aG docker \$USER  (e refaça o login)"
}

# Cria o .env na primeira execução e valida o que não pode ficar em branco.
need_env() {
  if [ ! -f .env ]; then
    if [ "${1:-}" = "prod" ]; then
      cp .env.example .env
    else
      # Em desenvolvimento a senha do banco não é uma decisão: geramos uma
      # e seguimos, para que um clone novo suba com um comando só.
      local pass
      pass=$(openssl rand -base64 24 2>/dev/null | tr -d '/+=' | head -c 24) || true
      [ -n "${pass}" ] || pass="dev$(date +%s)"
      sed "s|^DB_PASS=.*|DB_PASS=${pass}|" .env.example > .env
    fi
    ok "Criei o arquivo .env a partir do exemplo."
    if [ "${1:-}" = "prod" ]; then
      echo
      warn "Antes de subir em produção, edite o .env e defina:"
      echo "    DOMAIN       o domínio com DNS apontando para este servidor"
      echo "    ADMIN_EMAIL  seu e-mail (vira o login e registra o certificado)"
      echo "    DB_PASS      uma senha forte  ->  openssl rand -base64 32"
      echo
      die "Edite o .env e rode de novo."
    fi
  fi

  set -a; . ./.env; set +a

  if [ -z "${DB_PASS:-}" ]; then
    die "DB_PASS está vazio no .env."
  fi
  if [ "${DB_PASS}" = "troque-esta-senha-antes-de-subir" ]; then
    die "DB_PASS ainda está com o valor de exemplo.
    Gere uma senha de verdade:  openssl rand -base64 32"
  fi

  if [ "${1:-}" = "prod" ]; then
    if [ -z "${DOMAIN:-}" ] || [ "${DOMAIN}" = "localhost" ]; then
      die "Em produção o DOMAIN precisa ser um domínio real com DNS apontando
    para este servidor — hoje está '${DOMAIN:-vazio}'."
    fi
    if [ -z "${ADMIN_EMAIL:-}" ]; then
      die "ADMIN_EMAIL está vazio no .env."
    fi
  fi
  return 0
}

# ── portas ───────────────────────────────────────────────────
# Máquina de desenvolvimento costuma já ter Postgres ou Redis rodando.
# Sem isto, o usuário recebe um "address already in use" cru do Docker.

# Portas publicadas pelos nossos próprios containers. Sem isto, rodar
# ./tekvosoft dev com o ambiente no ar enxergaria as próprias portas como
# ocupadas e trocaria todas de lugar a cada execução.
own_ports() {
  docker ps --filter "label=com.docker.compose.project=tekvosoft" \
    --format '{{.Ports}}' 2>/dev/null \
    | tr ',' '\n' | sed -n 's/.*:\([0-9][0-9]*\)->.*/\1/p' | sort -u
}

is_own_port() {
  echo "${OWN_PORTS:-}" | grep -qx "$1"
}

port_busy() {
  local p="$1"
  # quem está usando é o próprio ambiente, que será recriado no lugar
  if is_own_port "$p"; then return 1; fi
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}\$"
  elif command -v netstat >/dev/null 2>&1; then
    netstat -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}\$"
  else
    return 1
  fi
}

first_free_port() {
  local p="$1"
  while port_busy "$p"; do p=$((p + 1)); done
  echo "$p"
}

# Troca no .env qualquer porta ocupada pela próxima livre.
ensure_free_ports() {
  local changed=0 name label cur new
  OWN_PORTS=$(own_ports)
  for entry in "PORT:frontend" "API_PORT:backend" "DB_PORT_HOST:postgres" \
               "REDIS_PORT_HOST:redis" "DEBUG_PORT:debugger"; do
    name="${entry%%:*}"; label="${entry##*:}"
    # o .env já foi carregado por need_env; usar a variável evita ter de
    # lidar com comentários e espaços na linha
    cur="${!name:-}"
    [ -n "$cur" ] || continue
    case "$cur" in (*[!0-9]*) continue ;; esac
    if port_busy "$cur"; then
      new="$(first_free_port $((cur + 1)))"
      sed -i "s|^${name}=.*|${name}=${new}|" .env
      warn "porta ${cur} (${label}) já está em uso nesta máquina — troquei para ${new}"
      changed=1
    fi
  done
  if [ "$changed" = "1" ]; then
    ok "Portas ajustadas no .env. Edite-o se quiser outras."
    set -a; . ./.env; set +a
    echo
  fi
}

# ── arquitetura das imagens ──────────────────────────────────
# O "compose up" nunca rebaixa uma imagem que já está no cache: usa a que
# encontrar, seja de qual arquitetura for. Quem em algum momento puxou um
# postgres ou redis de outra arquitetura nesta máquina (testando ARM, por
# exemplo) fica com ela guardada para sempre — o container morre com
# "exec format error" e a tela mostra só "container is unhealthy", que não
# diz nada sobre a causa. Por isso conferimos antes de subir.

# Plataforma desta máquina no formato que o Docker entende: linux/amd64.
host_platform() {
  local os arch
  os=$(docker version --format '{{.Server.Os}}' 2>/dev/null)     || return 1
  arch=$(docker version --format '{{.Server.Arch}}' 2>/dev/null) || return 1
  [ -n "$os" ] && [ -n "$arch" ] || return 1
  # fora de x86_64 e arm64 não temos o que decidir com segurança
  case "$arch" in amd64|arm64) ;; *) return 1 ;; esac
  echo "${os}/${arch}"
}

# A variante da arquitetura desta máquina está mesmo baixada?
image_matches_host() {
  local img="$1" plat="$2" arch
  # Docker com image store containerd: o que fica local é um índice com todas
  # as arquiteturas, mas só a que foi baixada tem config. Pedir a plataforma
  # do host revela se ela está lá de verdade — se não estiver, vem vazio.
  if docker image inspect --platform "$plat" "$img" \
       --format '{{.Architecture}}' 2>/dev/null | grep -q .; then
    return 0
  fi
  # Docker antigo, sem --platform no inspect: existe uma variante local só.
  arch=$(docker image inspect "$img" --format '{{.Architecture}}' 2>/dev/null) || return 1
  [ -n "$arch" ] && [ "$arch" = "${plat##*/}" ]
}

# Imagens que vêm prontas do Docker Hub (Postgres e Redis). As do backend e
# do frontend são compiladas aqui e já nascem na arquitetura certa.
infra_images() {
  grep -E '^[[:space:]]+image:[[:space:]]' "$BASE" | awk '{print $2}' | sort -u
}

ensure_native_images() {
  local plat img
  plat=$(host_platform) || return 0

  if [ -n "${DOCKER_DEFAULT_PLATFORM:-}" ] && [ "${DOCKER_DEFAULT_PLATFORM}" != "$plat" ]; then
    warn "seu shell define DOCKER_DEFAULT_PLATFORM=${DOCKER_DEFAULT_PLATFORM}, mas esta máquina é ${plat}."
    echo "${DIM}   Imagens de outra arquitetura não rodam aqui. Se algo não subir:"
    echo "       unset DOCKER_DEFAULT_PLATFORM${N}"
  fi

  for img in $(infra_images); do
    # ainda não baixada: o compose busca a variante certa sozinho
    docker image inspect "$img" >/dev/null 2>&1 || continue
    image_matches_host "$img" "$plat" && continue

    warn "a imagem ${img} guardada nesta máquina não é ${plat}."
    say "Baixando a versão ${plat} — sem ela o container não sobe..."
    if docker pull --platform "$plat" "$img" >/dev/null 2>&1; then
      ok "${img} corrigida para ${plat}."
      # Baixar a imagem certa não basta: um container já criado continua
      # preso à variante antiga, porque o compose o reaproveita quando a
      # configuração não mudou. Quem sobe precisa recriá-lo.
      IMAGES_FIXED=1
    else
      warn "não consegui baixar. Com internet, rode:
    docker pull --platform ${plat} ${img}"
    fi
  done
}

# "dependency failed to start: container ... is unhealthy" não conta o que
# aconteceu. O motivo está no log de quem não subiu; trazemos para a tela.
explain_up_failure() {
  local files="$1" svc logs arch_problem=0
  echo
  warn "A subida falhou. O que a infraestrutura registrou:"
  for svc in postgres redis; do
    logs=$(docker compose $files logs --tail=8 "$svc" 2>/dev/null || true)
    [ -n "$logs" ] || continue
    echo
    echo "   ${B}${svc}${N}"
    echo "$logs" | sed 's/^/     /'
    echo "$logs" | grep -q "exec format error" && arch_problem=1
  done
  echo
  if [ "$arch_problem" = "1" ]; then
    warn "'exec format error' significa imagem de outra arquitetura no cache."
    echo "${DIM}   Rode ./tekvosoft dev de novo com internet: ele rebaixa a imagem certa.${N}"
    echo
  fi
  echo "${DIM}   Log completo:  ./tekvosoft logs${N}"
}

# Descobre se o que está no ar é o ambiente de dev ou o de produção.
active_files() {
  if docker compose $DEV ps -q 2>/dev/null | grep -q .; then
    echo "$DEV"
  else
    echo "$PROD"
  fi
}

# ── comandos ─────────────────────────────────────────────────

# POSTGRES_PASSWORD só vale na criação do banco. Se o DB_PASS do .env mudar
# depois disso, o backend passa a falhar com "password authentication failed",
# que não diz nada sobre a causa. Detectamos e consertamos.
db_auth_ok() {
  local files="$1"
  docker compose $files run --rm -T --entrypoint sh tools -c \
    'PGPASSWORD="$DB_PASS" psql -h postgres -U "$DB_USER" -d "$DB_NAME" -c "select 1" >/dev/null 2>&1' \
    >/dev/null 2>&1
}

# Grava no banco a senha que está no .env, sem tocar nos dados. Funciona
# porque o pg_hba da imagem oficial confia em quem entra pelo socket local:
# de dentro do container não é preciso saber a senha para trocá-la.
realign_db_password() {
  local files="$1"
  echo "ALTER USER \"${DB_USER:-tekvosoft}\" WITH PASSWORD :'pw';" \
    | docker compose $files exec -T postgres \
        psql -U "${DB_USER:-tekvosoft}" -d "${DB_NAME:-tekvosoft}" \
             -v ON_ERROR_STOP=1 -v pw="${DB_PASS}" >/dev/null 2>&1
}

check_db_auth() {
  local files="$1"
  db_auth_ok "$files" && return 0

  # O caso comum é ter apagado a pasta do projeto e clonado de novo: o .env
  # nasce com uma senha nova, mas o volume do Postgres continuou aí com a
  # antiga. Apagar o banco resolveria, só que leva junto o que houver dentro.
  # Trocar a senha do banco pela do .env resolve sem perder nada.
  echo
  warn "O banco não aceitou a senha que está no .env."
  say "Gravando no banco a senha do .env (os dados continuam onde estão)..."
  if realign_db_password "$files" && db_auth_ok "$files"; then
    ok "Senha do banco realinhada."
    docker compose $files restart backend >/dev/null 2>&1 || true
    return 0
  fi

  echo
  warn "Não consegui ajustar a senha sozinho."
  echo "${DIM}   A senha do Postgres é gravada quando o banco é criado; mudar o"
  echo "   DB_PASS depois disso não muda a senha do banco que já existe.${N}"
  echo
  echo "   ${B}Se estes dados não importam${N} (ambiente de desenvolvimento):"
  echo "       ./tekvosoft reset        ${DIM}apaga o banco e recria com a senha nova${N}"
  echo
  echo "   ${B}Se os dados importam${N}:"
  echo "       devolva ao .env o DB_PASS antigo e suba de novo."
  echo
  return 1
}

# O frontend lê /config.json no boot (src/index.js) e NÃO tem alternativa:
# sem o arquivo ele mostra "Erro de configuração" e não sobe. Em produção
# quem gera é o entrypoint do nginx; em desenvolvimento precisamos gerar
# aqui, no host — de dentro do container o arquivo sairia pertencendo ao
# root, já que o código é montado por bind mount.
write_dev_config() {
  local out="frontend/public/config.json"
  cat > "${out}" <<EOF
{
  "BACKEND_PROTOCOL": "http",
  "BACKEND_HOST": "localhost",
  "BACKEND_PORT": "${API_PORT:-8080}",
  "BACKEND_PATH": "",
  "LOG_LEVEL": "debug"
}
EOF
  ok "Configuração do frontend apontando para http://localhost:${API_PORT:-8080}"
}

cmd_dev() {
  need_docker; need_env dev
  ensure_free_ports
  write_dev_config
  ensure_native_images
  say "Subindo o ambiente de desenvolvimento..."
  echo "${DIM}  Na primeira vez isto compila as dependências e pode levar alguns minutos.${N}"
  local recreate=""
  if [ "${IMAGES_FIXED:-0}" = "1" ]; then
    recreate="--force-recreate"
  fi
  if ! docker compose $DEV up -d --build $recreate; then
    explain_up_failure "$DEV"
    return 1
  fi
  echo
  ok "Ambiente no ar."
  echo
  echo "   ${B}Sistema${N}    http://localhost:${PORT:-3000}"
  echo "   ${B}API${N}        http://localhost:${API_PORT:-8080}"
  echo "   ${B}Login${N}      ${ADMIN_EMAIL:-admin@tekvosoft.local}  /  123456"
  echo
  echo "${DIM}   Edite backend/ ou frontend/ e recarrega sozinho.${N}"
  echo "${DIM}   Acompanhe os logs:  ./tekvosoft logs${N}"
  echo
  check_db_auth "$DEV" || return 1

  say "Aguardando o backend responder..."
  for _ in $(seq 1 90); do
    if curl -sf "http://localhost:${API_PORT:-8080}/" >/dev/null 2>&1; then
      ok "Backend respondendo."; return 0
    fi
    sleep 2
  done
  warn "O backend ainda não respondeu. Ele pode estar compilando — veja ./tekvosoft logs backend"
}

cmd_deploy() {
  need_docker; need_env prod
  say "Baixando as imagens (${TAG:-latest})..."
  docker compose $PROD pull
  say "Subindo os serviços..."
  docker compose $PROD up -d

  # O install.sh imprime o próprio resumo no fim; não repetimos aqui.
  [ -n "${TEKVOSOFT_QUIET:-}" ] && { ok "Serviços no ar."; return 0; }

  echo
  ok "Deploy concluído."
  echo
  echo "   ${B}Sistema${N}   https://${DOMAIN}"
  echo "   ${B}Login${N}     ${ADMIN_EMAIL}  /  123456"
  echo
  warn "Troque a senha no primeiro acesso."
  echo "${DIM}   O certificado HTTPS é emitido automaticamente e leva 1-2 minutos.${N}"
  echo "${DIM}   Acompanhe:  ./tekvosoft logs${N}"
}

cmd_update() {
  need_docker; need_env prod
  say "Fazendo backup antes de mexer..."
  if cmd_backup >/dev/null 2>&1; then
    ok "Backup guardado em ./backups"
  else
    warn "Não consegui fazer o backup (o sistema já estava no ar?). Continuando."
  fi
  say "Buscando imagens novas..."
  docker compose $PROD pull
  say "Reiniciando com a versão nova..."
  docker compose $PROD up -d
  say "Limpando imagens antigas..."
  docker image prune -f >/dev/null 2>&1 || true
  echo
  ok "Atualizado. https://${DOMAIN}"
  echo "${DIM}   Se algo quebrou, volte com:  ./tekvosoft rollback <tag>${N}"
}

# ── versões ──────────────────────────────────────────────────
# Dono do registro, derivado do REGISTRY do .env (ghcr.io/<dono>).
registry_owner() { echo "${REGISTRY:-ghcr.io/tekvosoft-chat}" | sed 's|.*/||'; }

# Lista as versões publicadas, da mais nova para a mais antiga.
# Devolve as versões publicadas, uma por linha, da mais nova para a mais
# antiga. Sai com 1 apenas se NÃO conseguiu falar com o registro — lista
# vazia é uma resposta legítima (ainda não há release).
published_versions() {
  local owner img token body
  owner="$(registry_owner)"
  img="tekvosoft-backend"

  token=$(curl -fsS --max-time 15 \
    "https://ghcr.io/token?scope=repository:${owner}/${img}:pull&service=ghcr.io" 2>/dev/null \
    | sed -n 's/.*"token":"\([^"]*\)".*/\1/p') || return 1
  [ -n "$token" ] || return 1

  body=$(curl -fsS --max-time 15 -H "Authorization: Bearer ${token}" \
    "https://ghcr.io/v2/${owner}/${img}/tags/list" 2>/dev/null) || return 1

  echo "$body" | tr ',' '\n' | sed -n 's/.*"\([0-9][0-9.]*\)".*/\1/p' \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -Vr || true
}

cmd_version() {
  # Comando informativo: carrega o .env se existir, mas não exige que
  # esteja configurado — consultar versões não depende de senha de banco.
  [ -f .env ] && { set -a; . ./.env; set +a; }
  echo
  echo "  ${B}Versões${N}"
  echo
  printf "     configurada no .env    %s\n" "${B}${TAG:-latest}${N}"

  # o que está de fato no ar
  local running=""
  if docker compose $PROD ps -q backend >/dev/null 2>&1 && [ -n "$(docker compose $PROD ps -q backend 2>/dev/null)" ]; then
    running=$(docker compose $PROD exec -T backend sh -c \
      'node -e "try{console.log(require(\"/usr/src/app/dist/gitinfo.js\").GitInfo.tagName||\"\")}catch(e){}"' 2>/dev/null | tr -d '\r')
  fi
  [ -n "$running" ] && printf "     rodando agora          %s\n" "${B}${running}${N}"

  echo
  say "Consultando as versões publicadas..."
  local list; list=$(published_versions) || {
    warn "Não consegui falar com o registro de imagens."
    echo; return 0
  }
  if [ -z "$list" ]; then
    echo "     ${DIM}Nenhuma release publicada ainda. Crie a primeira com:"
    echo "     ./tekvosoft release minor${N}"
  else
    echo "     ${B}disponíveis${N}"
    echo "$list" | head -10 | sed 's/^/       /'
    local total; total=$(echo "$list" | wc -l)
    [ "$total" -gt 10 ] && echo "       ${DIM}... e mais $((total - 10))${N}"
  fi
  echo
}

cmd_rollback() {
  need_docker; need_env prod
  if [ -z "${1:-}" ]; then
    echo
    warn "Diga para qual versão voltar. Por exemplo:  ./tekvosoft rollback 1.4.2"
    echo
    local list; list=$(published_versions 2>/dev/null) || true
    if [ -n "$list" ]; then
      echo "     ${B}Versões disponíveis${N}"
      echo "$list" | head -10 | sed 's/^/       /'
    fi
    echo
    exit 1
  fi
  local target="${1#v}"
  say "Voltando para a versão ${target}..."
  TAG="${target}" docker compose $PROD up -d
  ok "Rodando a versão ${target}."
  echo "${DIM}   Isto vale até o próximo update. Para fixar, ajuste TAG=${target} no .env${N}"
}

cmd_backup() {
  need_docker; need_env
  mkdir -p backups
  docker compose $(active_files) run --rm -T tools backup
}

cmd_restore() {
  need_docker; need_env
  [ -d backups ] || die "Não existe a pasta ./backups"
  echo
  docker compose $(active_files) run --rm -T tools list
  echo
  warn "A restauração SUBSTITUI todos os dados atuais pelo backup mais recente."
  read -r -p "Digite 'restaurar' para confirmar: " a
  if [ "$a" != "restaurar" ]; then die "Cancelado."; fi
  local f; f=$(active_files)
  docker compose $f run --rm -T tools restore "$@"
  say "Reiniciando o backend para reler os dados..."
  docker compose $f restart backend
  ok "Dados restaurados."
}

cmd_logs() {
  need_docker
  docker compose $(active_files) logs -f --tail=100 "$@"
}

cmd_ps() {
  need_docker
  echo "${B}desenvolvimento${N}"; docker compose $DEV ps 2>/dev/null || true
  echo; echo "${B}produção${N}";   docker compose $PROD ps 2>/dev/null || true
}

cmd_stop() {
  need_docker
  docker compose $DEV down 2>/dev/null || true
  docker compose $PROD down 2>/dev/null || true
  ok "Tudo parado. Os dados continuam salvos nos volumes."
}

cmd_shell() {
  need_docker
  local svc="${1:-backend}"
  docker compose $DEV exec "$svc" bash 2>/dev/null \
    || docker compose $PROD exec "$svc" bash 2>/dev/null \
    || die "O serviço '$svc' não está rodando."
}

cmd_psql() {
  need_docker; need_env
  docker compose $(active_files) exec postgres \
    psql -U "${DB_USER:-tekvosoft}" -d "${DB_NAME:-tekvosoft}"
}

cmd_reset() {
  need_docker
  warn "Isto APAGA o banco, o Redis e os arquivos enviados do ambiente de DESENVOLVIMENTO."
  read -r -p "Digite 'apagar' para confirmar: " a
  [ "$a" = "apagar" ] || die "Cancelado."
  docker compose $DEV down -v
  ok "Ambiente de desenvolvimento zerado. Rode ./tekvosoft dev para começar do zero."
}

cmd_release() {
  [ -d .git ] || die "Isto só funciona no repositório de desenvolvimento."
  command -v git >/dev/null 2>&1 || die "Git não está instalado."

  local kind="${1:-}"
  if [ -z "$kind" ]; then
    die "Diga o tamanho da mudança:

    ./tekvosoft release patch    correção            1.2.3 -> 1.2.4
    ./tekvosoft release minor    recurso novo        1.2.3 -> 1.3.0
    ./tekvosoft release major    quebra compatível   1.2.3 -> 2.0.0
    ./tekvosoft release 1.5.0    versão exata"
  fi

  # ── o repositório está em condições de publicar? ──
  local branch; branch=$(git rev-parse --abbrev-ref HEAD)
  if [ "$branch" != "main" ]; then
    die "Releases saem da main; você está na branch '${branch}'."
  fi
  if ! git diff --quiet || ! git diff --cached --quiet; then
    die "Há alterações não commitadas. Commite ou descarte antes de publicar."
  fi
  say "Sincronizando com o GitHub..."
  git fetch --quiet --tags origin || die "Não consegui falar com o GitHub."
  if [ -n "$(git log origin/main..HEAD --oneline 2>/dev/null)" ]; then
    die "Você tem commits que ainda não foram enviados. Rode 'git push' antes."
  fi
  if [ -n "$(git log HEAD..origin/main --oneline 2>/dev/null)" ]; then
    die "O GitHub está à frente do seu repositório. Rode 'git pull' antes."
  fi

  # ── calcula a próxima versão ──
  local last major minor patch new
  last=$(git tag -l 'v*.*.*' --sort=-v:refname | head -1)
  [ -n "$last" ] || last="v0.0.0"
  IFS=. read -r major minor patch <<EOF
${last#v}
EOF
  case "$kind" in
    patch) new="${major}.${minor}.$((patch + 1))" ;;
    minor) new="${major}.$((minor + 1)).0" ;;
    major) new="$((major + 1)).0.0" ;;
    [0-9]*|v[0-9]*)
      new="${kind#v}"
      echo "$new" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$' \
        || die "Versão inválida: '${kind}'. Use o formato 1.2.3." ;;
    *) die "Não entendi '${kind}'. Use patch, minor, major ou uma versão como 1.5.0." ;;
  esac

  git rev-parse "v${new}" >/dev/null 2>&1 && die "A versão v${new} já existe."

  # ── notas ──
  # Os commits "Versão X.Y.Z" são gerados por este próprio comando para
  # gravar o CHANGELOG; não fazem parte das alterações.
  local notes
  if [ "$last" = "v0.0.0" ]; then
    notes=$(git log --no-merges --pretty='- %s' -20 | grep -v '^- Versão [0-9]' || true)
  else
    notes=$(git log --no-merges --pretty='- %s' "${last}..HEAD" | grep -v '^- Versão [0-9]' || true)
  fi
  [ -n "$notes" ] || notes="- Sem alterações registradas desde ${last}."

  echo
  echo "  ${B}Publicar a versão ${new}${N}   ${DIM}(anterior: ${last})${N}"
  echo
  echo "$notes" | sed 's/^/     /'
  echo
  read -r -p "  Confirma? [s/N] " answer
  case "$answer" in [sS]|[sS][iI][mM]) ;; *) die "Cancelado." ;; esac

  # ── CHANGELOG ──
  local today; today=$(date +%Y-%m-%d)
  local tmp; tmp=$(mktemp)
  {
    echo            # separa do que vier antes — sem isto o cabeçalho cola
    echo            # na tabela do topo e o Markdown renderiza errado
    echo "## ${new} — ${today}"
    echo
    echo "$notes"
  } > "$tmp"

  if [ -f CHANGELOG.md ]; then
    # insere a nova seção logo após o cabeçalho do arquivo
    awk -v f="$tmp" '
      !done && /^## / { while ((getline l < f) > 0) print l; done=1 }
      { print }
      END { if (!done) { while ((getline l < f) > 0) print l } }
    ' CHANGELOG.md > "${tmp}.novo"
    mv "${tmp}.novo" CHANGELOG.md
  else
    { echo "# Histórico de versões"; echo; cat "$tmp"; } > CHANGELOG.md
  fi
  rm -f "$tmp"

  git add CHANGELOG.md
  git commit -q -m "Versão ${new}"
  git tag -a "v${new}" -m "Versão ${new}"

  say "Enviando..."
  git push -q origin main || die "Falha ao enviar os commits."
  git push -q origin "v${new}" || die "Falha ao enviar a tag."

  local repo; repo=$(git remote get-url origin | sed -e 's|.*github.com[:/]||' -e 's|\.git$||')
  cat <<EOF

  ${G}${B}Versão ${new} publicada.${N}

  O GitHub está compilando as imagens agora. Quando terminar:
     • as tags ${B}${new}${N}, ${B}${major:-}${N}... e ${B}latest${N} apontam para ela
     • a release aparece em https://github.com/${repo}/releases

  ${DIM}Acompanhe:  https://github.com/${repo}/actions
  Nos servidores:  sudo tekvosoft update${N}

EOF
}

cmd_help() {
  cat <<EOF

  ${B}vuup.me${N} ${DIM}— atendimento via WhatsApp com CRM e helpdesk${N}

  ${B}O dia a dia${N}
    ${C}dev${N}                 desenvolver aqui na sua máquina, com hot reload
    ${C}deploy${N}              subir em produção com HTTPS automático
    ${C}update${N}              atualizar a produção para a última versão

  ${B}Operação${N}
    ${C}logs${N} [serviço]      acompanhar os logs ao vivo
    ${C}ps${N}                  ver o que está rodando
    ${C}stop${N}                parar tudo (os dados continuam salvos)
    ${C}backup${N}              gravar um backup em ./backups
    ${C}restore${N}             restaurar o backup mais recente

  ${B}Versões${N}
    ${C}version${N}             ver a versão em uso e as disponíveis
    ${C}rollback${N} <versão>   voltar para uma versão anterior
    ${C}release${N} <tipo>      publicar uma versão nova ${DIM}(patch, minor, major)${N}

  ${B}Depuração${N}
    ${C}shell${N} [serviço]     abrir um terminal dentro do container
    ${C}psql${N}                abrir o console do banco de dados
    ${C}reset${N}               zerar o banco do ambiente de desenvolvimento

  ${B}Primeira vez?${N}
    ${DIM}Desenvolvimento:${N}  ./tekvosoft dev
    ${DIM}Produção:${N}         cp .env.example .env  →  edite  →  ./tekvosoft deploy

EOF
}

case "${1:-help}" in
  dev)      shift; cmd_dev "$@" ;;
  deploy)   shift; cmd_deploy "$@" ;;
  update)   shift; cmd_update "$@" ;;
  rollback) shift; cmd_rollback "$@" ;;
  version|versao|versão) shift; cmd_version "$@" ;;
  release)  shift; cmd_release "$@" ;;
  backup)   shift; cmd_backup "$@" ;;
  restore)  shift; cmd_restore "$@" ;;
  logs)     shift; cmd_logs "$@" ;;
  ps)       shift; cmd_ps "$@" ;;
  stop)     shift; cmd_stop "$@" ;;
  shell)    shift; cmd_shell "$@" ;;
  psql)     shift; cmd_psql "$@" ;;
  reset)    shift; cmd_reset "$@" ;;
  help|-h|--help) cmd_help ;;
  *) echo "Comando desconhecido: $1"; cmd_help; exit 1 ;;
esac
